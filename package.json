    "type": "git",
    "url": "git+https://github.com/katteni-kaihatu/kokosync.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/katteni-kaihatu/kokosync/issues"
  },
  "homepage": "https://github.com/katteni-kaihatu/kokosync#readme",
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@noble/hashes": "2.4.0"
  },
  "private": true
}
